# Credenziali del database di sviluppo locale: valgono solo per il container
# di questo progetto, non sono da riusare altrove.

MYSQL_ROOT_PASSWORD=esame_root
MYSQL_DATABASE=topologie
MYSQL_USER=esame
MYSQL_PASSWORD=esame

# Porta sul computer: 3307 per non dare fastidio a un MySQL già installato
MYSQL_PORT=3307

# Come l'API raggiunge il database quando la si lancia dal computer.
# Dentro docker compose questi due valori vengono sostituiti dal servizio api
# con db e 3306 (vedi docker-compose.yml).
DB_HOST=127.0.0.1
DB_PORT=3307

# Porta su cui ascolta l'API
PORT=3000

# Porta sul computer da cui si raggiunge l'API nel container
API_PORT=3000

# Porta sul computer da cui si raggiunge il frontend nel container.
# E' diversa dalla 4200 di "ng serve" apposta: cosi' le due versioni
# possono restare accese insieme senza darsi fastidio.
FRONTEND_PORT=8080
